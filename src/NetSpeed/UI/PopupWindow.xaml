<Window x:Class="NetSpeed.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSpeed 详情"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="376"
        Left="-4000" Top="-4000"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}">

  <Border x:Name="Card" Margin="16,12,16,16" CornerRadius="11"
          Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource CardBorderBrush}"
          BorderThickness="1">
    <Border.RenderTransform>
      <TranslateTransform x:Name="Slide" Y="8"/>
    </Border.RenderTransform>
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.32" Color="Black"/>
    </Border.Effect>

    <StackPanel Margin="18,16,18,13">

      <!-- ===== live totals ===== -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#x2193;" FontSize="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource DownBrush}"/>
            <TextBlock Text="下载" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <TextBlock x:Name="DownValue" Text="0" FontSize="27" FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="DownUnit" Text="B/s" FontSize="13" Margin="5,0,0,4"
                       VerticalAlignment="Bottom"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#x2191;" FontSize="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource UpBrush}"/>
            <TextBlock Text="上传" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <TextBlock x:Name="UpValue" Text="0" FontSize="27" FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="UpUnit" Text="B/s" FontSize="13" Margin="5,0,0,4"
                       VerticalAlignment="Bottom"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <Border Height="1" Margin="0,15,0,11" Background="{DynamicResource DividerBrush}"/>

      <!-- ===== process ranking ===== -->
      <Grid Margin="0,0,0,5">
        <TextBlock x:Name="ListTitle" Text="进程占用" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock x:Name="AdapterLabel" Text="" FontSize="12" HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="150"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
      </Grid>

      <ItemsControl x:Name="ProcessList" Margin="0,2,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Height="46">
              <Grid Margin="2,0,2,0" ToolTip="{Binding Tooltip}" Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="22" Height="22"
                      HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Border CornerRadius="5" Margin="1"
                          Background="{DynamicResource ControlBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/>
                  <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                  <TextBlock Text="{Binding Name}" FontSize="14"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <!-- Share of the busiest process, as a hairline under the name: it never has to
                       fight the icon or the numbers for space. -->
                  <Grid x:Name="BarHost" Height="3" Margin="0,6,0,0">
                    <Border CornerRadius="1.5" Background="{DynamicResource RowTrackBrush}"/>
                    <Border CornerRadius="1.5" HorizontalAlignment="Left"
                            Background="{DynamicResource BarFillBrush}">
                      <Border.Width>
                        <MultiBinding Converter="{StaticResource ShareWidth}">
                          <Binding Path="Share"/>
                          <Binding Path="ActualWidth" ElementName="BarHost"/>
                        </MultiBinding>
                      </Border.Width>
                    </Border>
                  </Grid>
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="&#x2193;" FontSize="12"
                             VerticalAlignment="Center" Foreground="{DynamicResource DownBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DownNum}" FontSize="12"
                             Margin="5,0,0,0" MinWidth="28" TextAlignment="Right"
                             Typography.NumeralAlignment="Tabular"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DownUnit}" FontSize="12"
                             Margin="4,0,0,0" MinWidth="34"
                             Foreground="{DynamicResource TextTertiaryBrush}"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="&#x2191;" FontSize="12"
                             Margin="0,2,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource UpBrush}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpNum}" FontSize="12"
                             Margin="5,2,0,0" MinWidth="28" TextAlignment="Right"
                             Typography.NumeralAlignment="Tabular"
                             Foreground="{DynamicResource TextTertiaryBrush}"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding UpUnit}" FontSize="12"
                             Margin="4,2,0,0" MinWidth="34"
                             Foreground="{DynamicResource TextTertiaryBrush}"/>
                </Grid>
              </Grid>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ===== states ===== -->
      <TextBlock x:Name="EmptyHint" Text="暂无进程占用网络" FontSize="13"
                 Margin="0,16,0,18" HorizontalAlignment="Center" Visibility="Collapsed"
                 Foreground="{DynamicResource TextTertiaryBrush}"/>

      <StackPanel x:Name="AdminHint" Margin="0,8,0,6" Visibility="Collapsed">
        <TextBlock Text="需要管理员权限才能统计进程流量" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock x:Name="AdminDetail" Text="Windows 只在内核事件跟踪中暴露每个进程的收发字节。"
                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
        <Button x:Name="ElevateButton" Content="以管理员身份重启" Style="{StaticResource AccentButton}"
                HorizontalAlignment="Left" Margin="0,12,0,2"/>
      </StackPanel>

      <Border Height="1" Margin="0,9,0,7" Background="{DynamicResource DividerBrush}"/>

      <Grid>
        <Button x:Name="SettingsButton" Style="{StaticResource SubtleButton}"
                HorizontalAlignment="Left" Padding="8,5" Margin="-8,0,0,0" FontSize="13">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Text="设置" Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ExitButton" Content="退出" Style="{StaticResource SubtleButton}"
                HorizontalAlignment="Right" Padding="8,5" Margin="0,0,-8,0" FontSize="13"/>
      </Grid>

    </StackPanel>
  </Border>
</Window>
